APP_NAME="Attica Attendance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance_local
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

APP_UPDATE_ANDROID_PACKAGE_NAME=app.abhibs.locatoremployee
APP_UPDATE_ANDROID_LATEST_VERSION=5.0.36
APP_UPDATE_ANDROID_LATEST_BUILD=5037
APP_UPDATE_ANDROID_MIN_SUPPORTED_BUILD=0
APP_UPDATE_ANDROID_FORCE=false
APP_UPDATE_ANDROID_DOWNLOAD_URL="https://play.google.com/store/apps/details?id=app.abhibs.locatoremployee&pcampaignid=web_share"
APP_UPDATE_ANDROID_TITLE="Update required"
APP_UPDATE_ANDROID_MESSAGE="A newer version of Attica Attendance is available. Please update the app to continue."
APP_UPDATE_ANDROID_RELEASE_NOTES=

# Store a bcrypt hash here; never commit the control password itself.
MOBILE_API_CONTROL_PASSWORD_HASH=
MOBILE_API_TOTP_SECRET=
MOBILE_API_TOTP_ISSUER="Attica Gold Emergency"

# Birthday SMS provider. Keep the token in the deployed environment only.
BIRTHDAY_SMS_ENDPOINT=
BIRTHDAY_SMS_TOKEN=
BIRTHDAY_SMS_SENDER_ID=
BIRTHDAY_SMS_TIMEOUT=15

# Browser-visible CARTO basemap key for the admin branch map.
CARTO_API_KEY=

# Optional integrations: disabled until configured for your environment.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
ATTICAGOLD_EMPLOYEE_SYNC_URL=
ATTICAGOLD_EMPLOYEE_SYNC_TOKEN=
ATTICAGOLD_EMPLOYEE_SYNC_TIMEOUT=15
VM_LOGIN_PASSWORD=
LIMITED_HR_EMAIL=

# Optional private payroll files; empty values use storage/app/private defaults.
PF_EMPLOYEES_PATH=
PF_SALARY_OVERRIDES_PATH=
